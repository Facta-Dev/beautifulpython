  "cards": [
    {
      "dot": "cyan",
      "title": "Commit then dispatch",
      "items": [
        "signup writes the user and the code row in one AsyncSession transaction; the .kiq dispatch rides after the commit",
        "the TaskIQ worker consumes the email.send task from the Dragonfly broker"
      ]
    },
    {
      "dot": "emerald",
      "title": "Code lifecycle",
      "items": [
        "codes expire in 24h, cap at 5 wrong guesses and are consumed on verify",
        "resend never reveals whether the account exists; a verified email answers 409"
      ]
    },
    {
      "dot": "rose",
      "title": "Login + tokens",
      "items": [
        "password first — one constant 401; then inactive → blocked → unverified, each a stable 403",
        "access JWT 900s; refresh is an opaque token rotated in place (replay fails the CAS)"
      ]
    }
  ]
