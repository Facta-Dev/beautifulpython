      "label": "entrypoint",
      "sublabel": "alembic upgrade head",
      "step": "01",
      "tag": "entry"
    },
    {
      "id": "wire",
      "type": "active",
      "label": "AppState.from_env",
      "sublabel": "config · engine · broker",
      "step": "02"
    },
    {
      "id": "serve",
      "type": "active",
      "label": "uvicorn serve",
      "sublabel": ":8000 · lifespan",
      "step": "03"
    },
    {
      "id": "ready",
      "type": "decision",
      "label": "readyz gate",
      "sublabel": "SELECT 1 · alembic",
      "step": "04",
      "tag": "gate"
    },
    {
      "id": "flow",
      "type": "success",
      "label": "Request flow",
      "sublabel": "slices · Pg* · TaskIQ",
      "step": "05",
      "tag": "done"
    },
    {
      "id": "authgate",
      "type": "waiting",
      "label": "Auth gate",
      "sublabel": "auth → rate-limit → authorize",
      "tag": "pause"
    },
    {
      "id": "drain",
      "type": "active",
      "label": "Worker drain",
      "sublabel": "fetch · ack · 2^n retry",
      "tag": "automatic"
    },
    {
      "id": "mfail",
      "type": "failure",
      "label": "Fatal down",
      "sublabel": "config · migration fail-closed",
      "tag": "terminal"
    },
    {
      "id": "degraded",
      "type": "failure",
      "label": "503 degraded",
      "sublabel": "DB unreachable",
      "tag": "terminal"
    },
    {
      "id": "recovered",
      "type": "success",
      "label": "Delivered / Settled",
      "sublabel": "ack · janitor clean",
      "tag": "terminal"
    }
  ],
  "transitions": [
    {
      "id": "t-boot-wire",
      "from": "boot",
      "to": "wire"
    },
    {
      "id": "t-wire-serve",
      "from": "wire",
      "to": "serve"
    },
    {
      "id": "t-serve-ready",
      "from": "serve",
      "to": "ready"
    },
    {
      "id": "t-ready-flow",
