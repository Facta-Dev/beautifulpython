    {
      "id": "t-wire-mfail",
      "from": "wire",
      "to": "mfail",
      "variant": "security",
      "label": "config invalid"
    },
    {
      "id": "t-flow-drain",
      "from": "flow",
      "to": "drain",
      "variant": "security",
      "label": "enqueue .kiq"
    },
    {
      "id": "t-drain-recovered",
      "from": "drain",
      "to": "recovered",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Boot rail",
      "items": [
        "lifespan runs pydantic-settings Config() → engine → TaskIQ broker → AppState.from_env",
        "config validates on boot and fails fast before uvicorn binds",
        "AppState.from_env wiring lives in the composition root — the layered contract's top ring; import-linter + TID251 keep the wiring from leaking outward"
      ]
    },
    {
      "dot": "emerald",
      "title": "Gates + drain",
      "items": [
        "every handler runs authenticate → rate-limit → authorize as Depends callables",
        "the TaskIQ worker owns its DI; failed tasks requeue with 2^n backoff and dead-letter at max_retries"
      ]
    },
    {
      "dot": "rose",
      "title": "Explicit endings",
      "items": [
        "/readyz probes SELECT 1 + alembic_version; DB down answers 503 degraded",
        "a migration or config failure kills the boot before the port opens"
      ]
    }
  ]
}