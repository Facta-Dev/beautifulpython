  "cards": [
    {
      "dot": "cyan",
      "title": "Core state",
      "items": [
        "users carries role and provider ids; sessions store hashed opaque refresh tokens",
        "pgvector columns pin one distance metric at the adapter; SQL stays in the adapter layer"
      ]
    },
    {
      "dot": "emerald",
      "title": "Queue",
      "items": [
        "dragonfly holds the TaskIQ queue; keys are service-namespaced with TTLs",
        ".kiq dispatch rides after the state-write commit — no dual-write gap"
      ]
    },
    {
      "dot": "rose",
      "title": "Delivery + ledgers",
      "items": [
        "failed sends back off 2^n and dead-letter at max_retries; delivery state is recorded in Postgres",
        "the janitor purges expired sessions and code rows hourly"
      ]
    }
  ]
